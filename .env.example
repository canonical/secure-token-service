# Secure Token Service - Environment Variables Template
# Copy this file to .env.local and populate with your values
# NEVER commit .env.local to version control

# Cache (Valkey/Redis) Configuration
CACHE_ADDR=valkey:6379
CACHE_PASSWORD=
CACHE_DB=0

# Server Configuration
HTTP_PORT=8080
GRPC_PORT=9090

# JWT Configuration
JWT_ISSUER=session-service
JWT_AUDIENCE=internal-services
JWT_EXPIRY=3600

# Cookie Encryption Keys (CHANGE THESE IN PRODUCTION!)
# Generate with: openssl rand -hex 32 (64 chars) and openssl rand -hex 16 (32 chars)
COOKIE_HASH_KEY=0123456789012345678901234567890123456789012345678901234567890123
COOKIE_BLOCK_KEY=01234567890123456789012345678901

# Database Configuration
DATABASE_URL=postgres://postgres:password@postgres:5432/sts?sslmode=disable

# OIDC Configuration (REPLACE WITH YOUR PROVIDER VALUES)
OIDC_PROVIDER_URL=https://accounts.google.com
OIDC_CLIENT_ID=your-oidc-client-id-from-provider
OIDC_CLIENT_SECRET=your-oidc-client-secret-from-provider
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
OIDC_SCOPES=openid,profile,email,offline_access

# JWKS Caching
JWKS_CACHE_TTL=600

# Observability
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true
TRACING_ENABLED=true
TRACING_ENDPOINT=
TRACING_SAMPLE_RATE=0.1
SERVICE_NAME=secure-token-service
SERVICE_VERSION=1.0.0

