  "cards": [
    { "dot": "cyan", "title": "Multi-Provider & M2M Ingress", "items": [
      "GET /auth/login?provider=oidc|openid — dynamic provider selection with fallback to DEFAULT_AUTH_PROVIDER",
      "GET /auth/callback — OIDC authorization code exchange & ID token verification",
      "GET /auth/openid/callback — Ubuntu One OpenID 2.0 direct verification via check_authentication POST",
      "M2M Client Credentials — automated machine callers authenticate directly via Ory Hydra (/oauth2/token)",
      "POST /auth/logout — terminates session in Valkey and clears standardized cookies"
    ] },
    { "dot": "emerald", "title": "Standardized Session & Cookie Security", "items": [
      "Dynamic Secure flag evaluated via TLS check (r.TLS != nil) or X-Forwarded-Proto == https",
      "AES-GCM encrypted state cookie (oauth_state) embedding selected provider, return_to, and nonce",
      "Opaque session cookie (session_id) with HttpOnly: true, SameSite: Lax, Path: /",
      "Valkey session store retains Provider ('oidc' | 'openid') and normalized Claims map"
    ] },
    { "dot": "rose", "title": "Dual Token Translation & Key Management", "items": [
      "gRPC ExchangeSession decodes session cookie and retrieves session & claims from Valkey",
      "gRPC ExchangeToken validates upstream Hydra access tokens and extracts machine identity (sub: client_id)",
      "JWT identity contract preserved: subject matches client identity, custom claims merged without override",
      "KeyManager signs internal JWT with ES256 using latest active PostgreSQL EC key"
    ] },
    { "dot": "violet", "title": "Observability & Resilience", "items": [
      "Prometheus /metrics endpoint tracks ExchangeSession and ExchangeToken latencies and outcomes",
      "OpenTelemetry tracing and structured Zap logs with correlation IDs",
      "Valkey JWKS key caching with 10-minute configurable TTL"
    ] }
  ]
