{
  "openspec-guard": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && python3 scripts/validate_openspec.py --quiet >/dev/null 2>&1; printf '{}\\n'",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "cd \"$(git rev-parse --show-toplevel </dev/null 2>/dev/null || pwd)\" && python3 scripts/openspec_stop_hook.py",
        "timeout": 30
      }
    ]
  }
}
