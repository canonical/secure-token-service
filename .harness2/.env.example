# Google harness2 + OpenSpec Configuration for Secure Token Service (Janus)
# Copy to .harness2/.env or export in your shell when running live LLM improver sessions.
# When HARNESS2_IMPROVER_MODEL is unset, `harness2-openspec` runs in deterministic local
# mode against the repository's OpenSpec artifacts and Go source tree.

# Improver channel: "opencode" (matches .github/workflows/opencode-*.yaml) or "claude_cli"
HARNESS2_IMPROVER_CHANNEL=opencode

# Model identifier for the improver/proposer sessions (e.g., Vertex AI / OpenRouter / Anthropic)
# HARNESS2_IMPROVER_MODEL=vertex_ai/claude-opus-4-6
HARNESS2_IMPROVER_MODEL=
HARNESS2_IMPROVER_EFFORT=high
HARNESS2_IMPROVER_TIMEOUT=1800
HARNESS2_IMPROVER_STEPS=50

# Concurrency and rollout parallelism
HARNESS2_PROPOSER_CONCURRENCY=4
HARNESS2_ROLLOUT_WORKERS=4

# Cloud credentials (for live Vertex AI or OpenRouter sessions)
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
OPENROUTER_API_KEY=

# Output root for recursive sweeps, audit trails, and experience library
HARNESS2_RUNS=/home/shipperizer/shipperizer/secure-token-service/.harness2/runs
